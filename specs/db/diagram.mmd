erDiagram
    agencies ||--o{ mission_agencies : "participates_in"
    missions ||--o{ mission_agencies : "involves_agencies"
    launches ||--o{ mission_launches : "triggers"
    agencies |o--o{ launches : "launch_service_provider"
    missions ||--o{ mission_launches : "involves_launches"
    spacecraft ||--o{ mission_spacecraft : "used_in"
    missions ||--o{ mission_spacecraft : "utilizes_spacecraft"
    missions ||--o{ mission_tags : "labeled_with"
    tags ||--o{ mission_tags : "applied_to"
    users |o--o{ mission_tags : "created_by"

    agencies {
        int agency_id PK "Surrogate key"
        string source_provider "Data source (e.g., ll2)"
        string source_id "Original ID from source"
        string name
        string abbrev
        char country_code
        string image_url
        string thumbnail_url
        string image_credit
        string image_license
    }

    launches {
        int launch_id PK "Surrogate key"
        string source_provider "Data source (e.g., ll2)"
        string source_id "Original UUID from source"
        string name
        datetime net
        string status
        int launch_service_provider_id FK "NULL = unknown"
        string image_url
        string thumbnail_url
        string image_credit
        string image_license
        datetime window_start
        datetime window_end
    }

    spacecraft {
        int spacecraft_id PK "Surrogate key"
        string source_provider "Data source (e.g., ll2)"
        string source_id "Original ID from source"
        string name
        string spacecraft_type
        string image_url
        string thumbnail_url
        string image_credit
        string image_license
    }

    missions {
        int mission_id PK "Surrogate key"
        string source_provider "Data source (e.g., ll2)"
        string source_id "Original ID from source"
        string name
        text description
        string target_body
        string status
        string image_url
        string thumbnail_url
        string image_credit
        string image_license
    }

    mission_agencies {
        int mission_id PK, FK
        int agency_id PK, FK
        string role
    }

    mission_launches {
        int mission_id PK, FK
        int launch_id PK, FK
    }

    mission_spacecraft {
        int mission_id PK, FK
        int spacecraft_id PK, FK
    }
    

    tags {
        int tag_id PK "Surrogate key"
        string name UK "Normalized: lowercase"
    }

    mission_tags {
        int mission_id PK, FK
        int tag_id PK, FK
        int created_by FK "NULL = anonymous"
        datetime created_at
    }

    users {
        int user_id PK "Reserved for authentication"
        string auth_provider
        string auth_subject
        string display_name
    }
